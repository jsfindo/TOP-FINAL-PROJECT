// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int           @id @default(autoincrement())
  name        String
  email       String        @unique
  password    String        // Added password field
  phone       String
  education   String
  desc        String
  experience  String
  skills      String
  applications Application[]
}

model Company {
  id          Int          @id @default(autoincrement())
  name        String
  email       String       @unique // Added email field for login
  password    String       // Added password field
  location    String
  desc        String
  websitelink String
  jobOpenings JobOpening[]
}

model JobOpening {
  id           Int           @id @default(autoincrement())
  companyId    Int // Scaled to store foreign key relation
  company      Company       @relation(fields: [companyId], references: [id])
  title        String
  desc         String
  dateClose    DateTime // Prisma uses DateTime for calendar dates
  applications Application[] // Virtual relation field: users who applied
}

model Application {
  id        Int        @id @default(autoincrement())
  openingId Int
  opening   JobOpening @relation(fields: [openingId], references: [id])
  userId    Int
  user      User       @relation(fields: [userId], references: [id])
  date      DateTime   @default(now()) // Prisma defaults to current timestamp
}